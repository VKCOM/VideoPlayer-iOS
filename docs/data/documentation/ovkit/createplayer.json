ывание видео."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Остановить и продолжить воспроизведение можно через свойство ","type":"text"},{"identifier":"doc:\/\/onevideo.OVKit\/documentation\/OVKit\/PlayerView\/paused","isActive":true,"type":"reference"},{"text":", которое имеет приоритет над ","type":"text"},{"identifier":"doc:\/\/onevideo.OVKit\/documentation\/OVKit\/PlayerView\/playerViewOnScreen","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Метод ","type":"text"},{"identifier":"doc:\/\/onevideo.OVKit\/documentation\/OVKit\/PlayerView\/stop()","isActive":true,"type":"reference"},{"text":" останавливает проигрывание и освобождает ресурсы плеера.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Чтобы получать события от плеера, необходимо реализовать протокол ","type":"text"},{"identifier":"doc:\/\/onevideo.OVKit\/documentation\/OVKit\/PlayerDelegate","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Видео можно сразу открыть в fullscreen представлении, передав ","type":"text"},{"identifier":"doc:\/\/onevideo.OVKit\/documentation\/OVKit\/Video","isActive":true,"type":"reference"},{"text":" и контроллер, с которого нужно презентовать: ","type":"text"},{"code":"PlayerView\/showFullscreen(_:on:fromTime:animated:playerViewSetupBlock:completion:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"PlayerView","type":"codeVoice"},{"type":"text","text":" поддерживает анимированное изменение размера:"}],"type":"paragraph"},{"code":["UIView.animate(withDuration: 1.0, delay: 0.0, options: .curveEaseInOut) {","  playerView.frame = newFrame","  playerView.layoutIfNeeded()","} completion: { _ in }"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"sections":[],"abstract":[{"type":"text","text":"Первые шаги после интеграции."}],"schemaVersion":{"major":0,