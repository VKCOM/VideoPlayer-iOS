/documentation\/OVKit\/ControlsViewDelegate\/updateControlsHidingState()","abstract":[{"type":"text","text":"Обновление статуса автоскрытия контролов."}],"title":"updateControlsHidingState()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"updateControlsHidingState","kind":"identifier"},{"text":"()","kind":"text"}]},"doc://onevideo.OVKit/documentation/OVKit/PlayerManagerDelegate/pictureInPictureControls(with:)":{"role":"symbol","url":"\/documentation\/ovkit\/playermanagerdelegate\/pictureinpicturecontrols(with:)","required":true,"abstract":[{"type":"text","text":"Контролы для использования в режиме “Картинка в Картинке”."}],"identifier":"doc:\/\/onevideo.OVKit\/documentation\/OVKit\/PlayerManagerDelegate\/pictureInPictureControls(with:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pictureInPictureControls","kind":"identifier"},{"text":"(","kind":"text"},{"text":"with","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@S@CGRect","text":"CGRect","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"c:objc(cs)UIView","text":"UIView","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","title":"pictureInPictureControls(with:)","kind":"symbol","navigatorTitle":[{"text":"pictureInPictureControlsWith:","kind":"identifier"}]},"doc://onevideo.OVKit/documentation/OVKit/Statistics":{"abstract":[{"type":"text","text":"Сбор статистики воспроизведения видео."}],"identifier":"doc:\/\/onevideo.OVKit\/documentation\/OVKit\/Statistics","type":"topic","title":"Статистика","kind":"article","role":"article","url":"\/documentation\/ovkit\/statistics"},"doc://onevideo.OVKit/documentation/OVKit/Fullscreen":{"role":"article","type":"topic","abstract":[{"text":"Кастомизация полноэкранного просмотра.","type":"text"}],"identifier":"doc:\/\/onevideo.OVKit\/documentation\/OVKit\/Fullscreen","url":"\/documentation\/ovkit\/fullscreen","kind":"article","title":"По